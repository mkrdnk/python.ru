# Export DJANGO_SETTINGS_MODULE in the process environment when selecting settings.
# manage.py defaults to python_ru.settings.development.
DJANGO_SETTINGS_MODULE=python_ru.settings.development
# Local-only placeholder; supply a unique secret outside git for production.
DJANGO_SECRET_KEY=local-development-only-not-for-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=
SITE_URL=http://localhost:8000

# Development uses SQLite by default. For PostgreSQL, export DATABASE_URL
# in the process environment (dj-database-url does not read this file).
# Docker Compose supplies its own local PostgreSQL connection.
#
# python_ru.settings.production requires these variables:
# DATABASES_ENGINE=django.db.backends.postgresql
# DATABASES_NAME=python_ru
# POSTGRES_API_USER=pythonru
# POSTGRES_API_PASSWORD=
# POSTGRES_API_HOST=localhost
# POSTGRES_API_PORT=5432
